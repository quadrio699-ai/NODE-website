# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (resend.com) — for the contact form. Leave blank during local
# dev and submissions will just be logged to the console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=Quadrio699@gmail.com

# Site URL — used in sitemap.xml, robots.txt, Open Graph tags, and JSON-LD.
# Update once you're on a custom domain.
NEXT_PUBLIC_SITE_URL=https://node-website-mu.vercel.app

# Google Search Console — Settings → verification via "HTML tag" method
# gives you a content value like "abc123..."; paste just that value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — Admin → Data Streams → your web stream → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
